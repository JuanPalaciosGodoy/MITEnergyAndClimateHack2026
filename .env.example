# Copy this file to .env and enter your own EIA key.
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=""

# Optional personal OpenEI key. DEMO_KEY works for small validation queries.
# https://openei.org/services/api/signup/
OPENEI_API_KEY=""

# Optional frontend origins, separated by commas. Defaults include localhost ports 3000 and 5173.
# CORS_ORIGINS=http://localhost:5173
